<?php

declare(strict_types=1);

namespace AIArmada\Events\Models;

use Illuminate\Database\Eloquent\Model;
use Illuminate\Database\Eloquent\Relations\BelongsTo;

/**
 * @property string $id
 * @property string $event_id
 * @property string|null $event_occurrence_id
 * @property string|null $event_session_id
 * @property string|null $display_name
 * @property string|null $involveable_type
 * @property string|null $involveable_id
 * @property string|null $event_role_id
 * @property string|null $role_code
 * @property string $status
 * @property string $visibility
 * @property int $prominence
 * @property bool $is_featured
 * @property bool $is_primary
 * @property \DateTimeInterface|null $starts_at
 * @property \DateTimeInterface|null $ends_at
 * @property string|null $replaced_by_involvement_id
 * @property string|null $replacement_reason
 * @property string|null $notes
 * @property int $sort_order
 * @property array<array-key, mixed>|null $metadata
 * @property \DateTimeInterface|null $created_at
 * @property \DateTimeInterface|null $updated_at
 * @property-read TEvent $event
 *
 * @template TEvent of Model = Model
 */
class EventInvolvement extends Model
{
    /** @return BelongsTo<TEvent, $this> */
    public function event(): BelongsTo {}
}

/**
 * @property string $id
 * @property string $event_id
 * @property string|null $event_occurrence_id
 * @property string|null $event_session_id
 * @property string|null $registrant_type
 * @property string|null $registrant_id
 * @property string $registration_no
 * @property string $registration_type
 * @property mixed $status
 * @property string $source
 * @property int $total_participants
 * @property int $total_amount
 * @property string $currency
 * @property string|null $external_order_id
 * @property string|null $external_order_type
 * @property string|null $payment_status
 * @property \DateTimeInterface|null $registered_at
 * @property \DateTimeInterface|null $approved_at
 * @property \DateTimeInterface|null $completed_at
 * @property \DateTimeInterface|null $cancelled_at
 * @property \DateTimeInterface|null $rejected_at
 * @property \DateTimeInterface|null $waitlisted_at
 * @property \DateTimeInterface|null $refund_pending_at
 * @property \DateTimeInterface|null $refunded_at
 * @property \DateTimeInterface|null $expired_at
 * @property \DateTimeInterface|null $last_state_change_at
 * @property string|null $status_reason
 * @property string|null $notes
 * @property string|null $parent_registration_id
 * @property bool $is_bundle_root
 * @property array<string, mixed>|null $pass_entitlements
 * @property string|null $idempotency_key
 * @property array<string, mixed>|null $metadata
 * @property \DateTimeInterface|null $created_at
 * @property \DateTimeInterface|null $updated_at
 * @property-read TEvent $event
 *
 * @template TEvent of Model = Model
 */
class EventRegistration extends Model
{
    /** @return BelongsTo<TEvent, $this> */
    public function event(): BelongsTo {}
}

/**
 * @property string $id
 * @property string|null $submitter_type
 * @property string|null $submitter_id
 * @property string|null $target_type
 * @property string|null $target_id
 * @property string|null $event_id
 * @property string|null $event_occurrence_id
 * @property string|null $event_session_id
 * @property mixed|null $submission_data
 * @property mixed $status
 * @property \DateTimeInterface|null $submitted_at
 * @property \DateTimeInterface|null $reviewed_at
 * @property string|null $review_reason
 * @property string|null $review_notes
 * @property array<array-key, mixed>|null $metadata
 * @property \DateTimeInterface|null $created_at
 * @property \DateTimeInterface|null $updated_at
 * @property-read TEvent|null $event
 *
 * @template TEvent of Model = Model
 */
class EventSubmission extends Model
{
    /** @return BelongsTo<TEvent, $this> */
    public function event(): BelongsTo {}
}
