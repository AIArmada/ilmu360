{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "aiarmada/ilmu360",
    "type": "project",
    "description": "Perjalanan Menuju Allah",
    "keywords": [
        "perjalanan menuju Allah",
        "ilmu360"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "aiarmada/addressing": "dev-main",
        "aiarmada/affiliates": "dev-main",
        "aiarmada/authz": "dev-main",
        "aiarmada/commerce-support": "dev-main",
        "aiarmada/communications": "dev-main",
        "aiarmada/contacting": "dev-main",
        "aiarmada/engagement": "dev-main",
        "aiarmada/events": "dev-main",
        "aiarmada/filament-addressing": "dev-main",
        "aiarmada/filament-authz": "dev-main",
        "aiarmada/filament-communications": "dev-main",
        "aiarmada/filament-contacting": "dev-main",
        "aiarmada/filament-engagement": "dev-main",
        "aiarmada/filament-events": "dev-main",
        "aiarmada/filament-inventory": "dev-main",
        "aiarmada/filament-seating": "dev-main",
        "aiarmada/filament-signals": "dev-main",
        "aiarmada/filament-ticketing": "dev-main",
        "aiarmada/inventory": "dev-main",
        "aiarmada/membership": "dev-main",
        "aiarmada/moderation": "dev-main",
        "aiarmada/references": "dev-main",
        "aiarmada/seating": "dev-main",
        "aiarmada/signals": "dev-main",
        "aiarmada/ticketing": "dev-main",
        "bezhansalleh/filament-language-switch": "^5.0",
        "dedoc/scramble": "^0.13.26",
        "filament/filament": "^5.6.7",
        "filament/spatie-laravel-media-library-plugin": "^5.0",
        "filament/spatie-laravel-settings-plugin": "^5.0",
        "filament/spatie-laravel-tags-plugin": "^5.0",
        "http-interop/http-factory-guzzle": "^1.2",
        "itsgoingd/clockwork": "^5.3",
        "laravel/ai": "^0.9",
        "laravel/fortify": "^1.37",
        "laravel/framework": "^13.15",
        "laravel/horizon": "^5.47",
        "laravel/mcp": "^0.8",
        "laravel/octane": "^2.17",
        "laravel/passport": "^13.7",
        "laravel/sanctum": "^4.3",
        "laravel/scout": "^11.2",
        "laravel/socialite": "^5.27",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.34",
        "livewire/blaze": "^1.0",
        "livewire/flux": "^2.14",
        "lorisleiva/laravel-actions": "^2.10",
        "nnjeim/world": "^1.1",
        "nunomaduro/essentials": "^1.0",
        "owen-it/laravel-auditing": "^14.0",
        "spatie/eloquent-sortable": "^5.0",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-deleted-models": "^1.2",
        "spatie/laravel-model-states": "^2.14",
        "spatie/laravel-query-builder": "^7.3",
        "spatie/laravel-sluggable": "^4.0",
        "tapp/filament-auditing": "^4.0",
        "typesense/typesense-php": "^6.0",
        "ysfkaya/filament-phone-input": "^4.2"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.5",
        "fakerphp/faker": "^1.23",
        "filament/blueprint": "^2.0",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.0",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.62",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/phpstan": "^2.2",
        "rector/rector": "^2.4",
        "spatie/guidelines-skills": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan horizon:listen\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,horizon,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "/Users/Saiffil/Herd/commerce/packages/*"
        },
        {
            "name": "filament",
            "type": "composer",
            "url": "https://packages.filamentphp.com/composer"
        }
    ]
}
