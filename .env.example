APP_NAME="ilmu360°"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://ilmu360.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
SANCTUM_TOKEN_PREFIX=ilmu360_
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local Google OAuth bridge: Google cannot redirect to *.test domains, so the
# callback goes through the Cloudflare Tunnel hostname instead. Must match the
# authorized redirect URI in Google Cloud Console exactly.
GOOGLE_REDIRECT_URI=https://dev.ilmu360.com/oauth/google/callback

# Ummah API — global prayer-times fallback (server-side only, X-API-Key header)
UMMAH_API_KEY=

# Prayer-times providers — exact per-zone clocks instead of hardcoded estimates.
# Keep false until Horizon + scheduler run prefetch/rollover warming in prod.
PRAYER_PROVIDERS_ENABLED=false
# Short per-request budget for upstream prayer APIs (seconds).
PRAYER_HTTP_TIMEOUT=3
