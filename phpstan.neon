includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon

parameters:
    level: 6
    configDirectories:
        - config
        - app/Features/Prayer/Config
    paths:
        - app
        - bootstrap
        - config
        - database
        - routes
        - tools
        - vendor/aiarmada/affiliates/src

    tmpDir: storage/phpstan
    reportUnmatchedIgnoredErrors: true
    treatPhpDocTypesAsCertain: false

    parallel:
        maximumNumberOfProcesses: 4

    excludePaths:
        analyse:
            - bootstrap/cache/*
            - storage/*
            - vendor/*
            - node_modules/*
            - tests/*

services:
    -
        class: Tools\PhpStan\MorphModelResolverReturnTypeExtension
        tags:
            - phpstan.broker.dynamicStaticMethodReturnTypeExtension
    -
        class: Tools\PhpStan\MorphHelperReturnTypeExtension
        arguments:
            helperClass: App\Features\Events\Support\EventModel
        tags:
            - phpstan.broker.dynamicStaticMethodReturnTypeExtension
    -
        class: Tools\PhpStan\MorphHelperReturnTypeExtension
        arguments:
            helperClass: App\Features\Contributions\Support\ContributionModel
        tags:
            - phpstan.broker.dynamicStaticMethodReturnTypeExtension
    -
        class: Tools\PhpStan\MorphHelperReturnTypeExtension
        arguments:
            helperClass: App\Features\Rewards\Support\RewardsModel
        tags:
            - phpstan.broker.dynamicStaticMethodReturnTypeExtension
