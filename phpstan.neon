includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 6
    configDirectories:
        - config
        - app/Features/Prayer/Config
    stubFiles:
        - phpstan-events.stub
    paths:
        - app
        - bootstrap
        - config
        - database
        - routes
        - tools
        - vendor/aiarmada/affiliates/src

    tmpDir: storage/phpstan
    reportUnmatchedIgnoredErrors: true
    treatPhpDocTypesAsCertain: false

    parallel:
        maximumNumberOfProcesses: 8

    excludePaths:
        analyse:
            - bootstrap/cache/*
            - storage/*
            - vendor/*
            - node_modules/*
            - tests/*

services:
    -
        class: Tools\PhpStan\MorphModelResolverReturnTypeExtension
        tags:
            - phpstan.broker.dynamicStaticMethodReturnTypeExtension
    -
        class: Tools\PhpStan\MorphHelperReturnTypeExtension
        arguments:
            helperClass: App\Features\Events\Support\EventModel
        tags:
            - phpstan.broker.dynamicStaticMethodReturnTypeExtension
    -
        class: Tools\PhpStan\MorphHelperReturnTypeExtension
        arguments:
            helperClass: App\Features\Directory\Support\DirectoryModel
        tags:
            - phpstan.broker.dynamicStaticMethodReturnTypeExtension
