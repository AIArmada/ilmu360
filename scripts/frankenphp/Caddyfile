{
    admin {$CADDY_SERVER_ADMIN_HOST:localhost}:{$CADDY_SERVER_ADMIN_PORT:2469}
    auto_https off

    frankenphp {
        php_ini "memory_limit" "512M"
        php_ini "opcache.memory_consumption" "512"
        php_ini "opcache.interned_strings_buffer" "64"
        php_ini "opcache.max_accelerated_files" "32531"
        php_ini "opcache.max_wasted_percentage" "20"
        php_ini "opcache.validate_timestamps" "1"
        php_ini "opcache.revalidate_freq" "2"
        php_ini "realpath_cache_size" "4096K"
        php_ini "realpath_cache_ttl" "600"

        worker {
            file "{$APP_PUBLIC_PATH}/frankenphp-worker.php"
            {$CADDY_SERVER_WORKER_DIRECTIVE}
        }
    }
}

{$CADDY_SERVER_SERVER_NAME:http://:8450} {
    root * "{$APP_PUBLIC_PATH}"
    php_server

    log {
        output file "{$APP_BASE_PATH}/storage/logs/frankenphp-access.log"
    }
}
