parameters:
	ignoreErrors:
		-
			message: '#^Variable \$schedule on left side of \?\? is never defined\.$#'
			identifier: nullCoalesce.variable
			count: 1
			path: app/Actions/Events/SaveAdminEventAction.php

		-
			message: '#^Property App\\Models\\Event\:\:\$schedule_kind \(string\|null\) does not accept AIArmada\\Events\\Enums\\ScheduleKind\.$#'
			identifier: assign.propertyType
			count: 1
			path: app/Actions/Events/SyncEventScheduleAction.php

		-
			message: '#^Using nullsafe property access "\?\-\>value" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: app/Actions/Events/SyncEventScheduleAction.php

		-
			message: '#^Method App\\Actions\\Fortify\\ResetUserPassword\:\:passwordRules\(\) should return array\<int, array\<mixed\>\|Illuminate\\Contracts\\Validation\\ValidationRule\|string\> but returns array\<int, Illuminate\\Validation\\Rules\\Password\|string\>\.$#'
			identifier: return.type
			count: 1
			path: app/Actions/Fortify/ResetUserPassword.php

		-
			message: '#^Trait App\\Concerns\\ProfileValidationRules is used zero times and is not analysed\.$#'
			identifier: trait.unused
			count: 1
			path: app/Concerns/ProfileValidationRules.php

		-
			message: '#^Return type \(Illuminate\\Database\\Eloquent\\Relations\\HasMany\<App\\Models\\EventSubmission, \$this\(App\\Models\\Event\)\>\) of method App\\Models\\Event\:\:submissions\(\) should be compatible with return type \(Illuminate\\Database\\Eloquent\\Relations\\HasMany\<AIArmada\\Events\\Models\\EventSubmission, \$this\(AIArmada\\Events\\Models\\Event\)\>\) of method AIArmada\\Events\\Models\\Event\:\:submissions\(\)$#'
			identifier: method.childReturnType
			count: 1
			path: app/Models/Event.php

		-
			message: '#^Method App\\Rules\\TeamName\:\:routesPrefixes\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Rules/TeamName.php

		-
			message: '#^Call to an undefined method DateTimeInterface\:\:toIso8601String\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: app/Services/Notifications/NotificationSettingsManager.php

		-
			message: '#^Parameter \#1 \$callback of method Illuminate\\Database\\Eloquent\\Factories\\Factory\<AIArmada\\Events\\Models\\Event\>\:\:afterCreating\(\) expects Closure\(AIArmada\\Events\\Models\\Event\)\: mixed, Closure\(App\\Models\\Event\)\: void given\.$#'
			identifier: argument.type
			count: 1
			path: database/factories/EventFactory.php
