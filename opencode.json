{
    "$schema": "https://opencode.ai/config.json",
    "plugin": ["@warp-dot-dev/opencode-warp", "superpowers@git+https://github.com/obra/superpowers.git"],
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "artisan",
                "boost:mcp"
            ]
        },
        "codebase-memory-mcp": {
            "type": "local",
            "enabled": true,
            "command": [
                "/Users/Saiffil/.local/bin/codebase-memory-mcp"
            ]
        }
    }
}